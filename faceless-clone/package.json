{
  "name": "faceless-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/server/worker.ts",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"npm run dev\" \"npm run worker\"",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.2.5",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.2.6",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@remotion/bundler": "^4.0.261",
    "@remotion/renderer": "^4.0.261",
    "@tanstack/react-query": "^5.66.0",
    "@types/ws": "^8.18.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.474.0",
    "luxon": "^3.5.0",
    "msedge-tts": "^1.3.0",
    "next": "^14.2.35",
    "node-cron": "^3.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.54.2",
    "remotion": "^4.0.261",
    "sharp": "^0.33.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
